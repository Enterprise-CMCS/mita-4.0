{
  "enabled": true,
  "name": "Sync Docs on Source Change",
  "description": "When any HTML, CSS, or JS source file changes, asks the agent to update the README or any relevant docs to reflect the changes.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*.html",
      "*.css",
      "*.js",
      ".kiro/steering/*.md"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A source file was just edited in this static site project. Review the change and determine if any documentation needs to be updated. Check the README (if it exists) and the .kiro/steering/ folder (structure.md, tech.md, product.md) for any content that may be outdated given the change. If the change adds a new page, modifies the nav structure, introduces a new CSS file, changes the JS behavior, or alters any conventions described in the docs, update the relevant documentation to reflect the current state of the project. Only update docs if something is actually out of date — do not make trivial or redundant edits."
  }
}